# copy to .env before `npm run build`. this file is per-machine and gitignored:
# do NOT commit a filled-in copy, and do NOT add a .env.production — next loads
#
#   .env.production.local > .env.local > .env.production > .env
#
# so a stray .env.production silently wins over .env and bakes the wrong host
# into the browser bundle.

# express api — used by client components (must be NEXT_PUBLIC_ to reach the browser)
#
# NEXT_PUBLIC_* is inlined into the browser bundle at BUILD time, so this has to
# be right *before* `npm run build`. Setting it in pm2 afterwards does nothing.
#
# this is the url the *browser* calls, so localhost only works when the browser
# is on the same machine as the api. In production use the public origin the app
# is served from, e.g. http://172.16.113.21/invoicer — and if that is a
# different origin than the app itself, add it to CORS_ORIGINS on the backend.
#
# NO trailing slash and NO trailing /api: the client appends /api itself
# (src/lib/api-client.js), so .../invoicer/api here becomes .../invoicer/api/api.
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# express api — used by server components, read at RUNTIME (so pm2 can set it).
# keep this internal; it never leaves the box. same "no /api suffix" rule.
API_BASE_URL="http://localhost:8000"
