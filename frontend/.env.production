# build-time config for `next build` / `next start` (the pm2 deployment).
#
# NEXT_PUBLIC_* is inlined into the browser bundle at BUILD time, so this file
# has to be right before you run `npm run build` — setting it in pm2 later has
# no effect on what the browser calls.
#
# this holds no secrets, so it is committed on purpose (see .gitignore) to keep
# server builds reproducible. secrets live in backend/.env.

# IMPORTANT: this is the url the *browser* calls. localhost only works when the
# browser is on the same machine as the api. Serving real users means putting
# the api's public url here (e.g. https://invoicer.example.com:5100) and adding
# that origin to CORS_ORIGINS on the backend.
NEXT_PUBLIC_API_BASE_URL="http://localhost:5100"

# the url server components call, from inside the box — stays internal
API_BASE_URL="http://localhost:5100"
