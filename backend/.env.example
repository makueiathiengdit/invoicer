# server
PORT=8000
NODE_ENV=development

# database
LOCAL_DB_URL="mongodb://localhost:27017/invoice_db"
MONGO_DB_URL="mongodb://localhost:27017/invoice_db"

# auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="4h"

# defaults to true in production. set it to false if you serve the app over
# plain http, otherwise the browser drops the session cookie and login fails.
# COOKIE_SECURE=false

# comma separated list of origins allowed to call the api with credentials
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# max size of a json body (invoice attachments are posted as base64)
JSON_BODY_LIMIT="15mb"
